<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KoalaNotes.MainWindow"
        Icon="avares://KoalaNotes/Assets/koala.ico"
        Title="Koala Notes" Width="1200" Height="750"
        Background="#0d1117" Foreground="#e6edf3"
        FontFamily="Cascadia Code, Fira Code, Consolas, monospace"
        RequestedThemeVariant="Dark">

    <Grid>
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- TOP BAR -->
            <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Height="48" Padding="16,0">
                <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto">
                    <TextBlock Grid.Column="0" Text="KOALA_NOTES" VerticalAlignment="Center" FontWeight="Bold" Foreground="#7c6bff" Margin="0,0,16,0" FontSize="14" LetterSpacing="0.06"/>

                    <ComboBox Grid.Column="1" Name="PageNavigationDropdown" SelectionChanged="OnPageNavigationChanged" SelectedIndex="0" Width="200" VerticalAlignment="Center" Background="#21262d" BorderBrush="#30363d" Margin="0,0,8,0">
                        <ComboBoxItem Content="- Tool Selection -" Tag="toolselection"/>
                        <ComboBoxItem Content="Encoder Module" Tag="encoder"/>
                        <ComboBoxItem Content="Exploit Database" Tag="exploit"/>
                        <ComboBoxItem Content="HTTP Repeater" Tag="repeater"/>
                        <ComboBoxItem Content="IP Geolocation" Tag="ip"/>
                        <ComboBoxItem Content="Notes Workspace" Tag="notes"/>
                        <ComboBoxItem Content="Obfuscation Pipe" Tag="obfuscate"/>
                        <ComboBoxItem Content="OSINT Master Hub" Tag="osint"/>
                        <ComboBoxItem Content="Reverse Shells" Tag="rshells"/>
                        <ComboBoxItem Content="SQLi Payload Lab" Tag="sqli"/>
                        <ComboBoxItem Content="Web Shells" Tag="webshells"/>
                    </ComboBox>

                    <!-- + note button right next to the dropdown -->
                    <Button Grid.Column="2" Name="GlobalNewNoteBtn" Content="+ note" Click="OnNewNoteClick"
                            Background="Transparent" BorderBrush="#3fb950" Foreground="#3fb950"
                            Padding="12,5" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <!-- spacer -->
                    <Grid Grid.Column="3"/>

                    <Button Grid.Column="4" Content="import" Click="OnImportClick" Background="#3d3680" BorderBrush="#7c6bff" Foreground="#e6edf3" Margin="0,0,8,0" Padding="12,5"/>
                    <Button Grid.Column="5" Content="export" Click="OnExportClick" Background="#3d3680" BorderBrush="#7c6bff" Foreground="#e6edf3" Margin="0,0,8,0" Padding="12,5"/>
                    <Button Grid.Column="6" Content="delete" Click="OnUniversalDeleteClick" Background="Transparent" BorderBrush="#f85149" Foreground="#f85149" Padding="12,5"/>
                </Grid>
            </Border>

            <!-- MAIN BODY -->
            <Grid Grid.Row="1" Name="MainBodyLayoutGrid" ColumnDefinitions="230, 4, *">

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Name="AppSidebarPanel" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,1,0" IsVisible="True">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="12,10,12,6">
                            <TextBlock Grid.Column="0" Text="CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="#6e7681" LetterSpacing="1" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Name="RenameCategoryBtn" Content="edit" Click="OnRenameCategoryClick" Background="Transparent" BorderBrush="#30363d" FontSize="11" Padding="6,4" Margin="0,0,4,0"/>
                            <Button Grid.Column="2" Name="AddCategoryBtn" Content="+ new" Click="OnAddCategoryClick" Background="#3d3680" BorderBrush="#7c6bff" FontSize="11" FontWeight="Bold" Padding="6,4"/>
                        </Grid>
                        <Border Grid.Row="1" Padding="12,0,12,10" BorderBrush="#30363d" BorderThickness="0,0,0,1">
                            <TextBox Name="SidebarSearchBox" Watermark="Search notes..." TextChanged="OnSearchBoxChanged" KeyDown="OnGlobalKeyDown" FontSize="11" Background="#21262d" Foreground="#e6edf3" BorderBrush="#30363d" Padding="10,6"/>
                        </Border>
                        <TreeView Grid.Row="2" Name="NotesCategoryTree" SelectionChanged="OnTreeSelectionChanged" DragDrop.AllowDrop="True" Background="Transparent" BorderThickness="0" Margin="4"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Background="#30363d" ResizeDirection="Columns" Width="4" HorizontalAlignment="Stretch"/>

                <!-- CONTENT PANELS -->
                <Grid Grid.Column="2">

                    <!-- NOTES PANEL -->
                    <Grid Name="ViewNotesPanel" RowDefinitions="Auto, *" IsVisible="True">
                        <Grid Grid.Row="0" ColumnDefinitions="*" Background="#0d1117" Margin="24,10,24,0">
                            <TextBox Grid.Column="0" Name="NoteTitleTxt" TextChanged="OnNoteFieldsChanged" Watermark="Note Title..." FontSize="14" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Foreground="#e6edf3"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <StackPanel Name="EmptyWorkspaceState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsVisible="True">
                                <TextBlock Text="◈" FontSize="36" HorizontalAlignment="Center" Foreground="#6e7681" Opacity="0.3"/>
                                <TextBlock Text="select a category and note, or create one" FontSize="13" Foreground="#6e7681"/>
                                <Button Content="+ new note" Click="OnNewNoteClick" HorizontalAlignment="Center" Background="Transparent" BorderBrush="#30363d" Foreground="#8b949e" Padding="18,7"/>
                            </StackPanel>
                            <TextBox Name="NoteBodyTxt" TextChanged="OnNoteFieldsChanged" Watermark="Write your notes here..." AcceptsReturn="True" TextWrapping="Wrap" Background="#0d1117" Foreground="#e6edf3" BorderThickness="0" Padding="24,20" FontSize="13" IsVisible="False"/>
                        </Grid>
                    </Grid>

                    <!-- ENCODER PANEL -->
                    <Grid Name="ViewEncoderPanel" IsVisible="False" Margin="24,20" RowDefinitions="Auto, Auto, Auto, Auto, *">
                        <TextBlock Grid.Row="0" Text="INPUT" FontSize="10" FontWeight="Bold" Foreground="#6e7681" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="1" Name="EncoderInputBox" TextChanged="OnEncoderInputChanged" Height="100" AcceptsReturn="True" TextWrapping="Wrap" Background="#161b22" BorderBrush="#30363d" Foreground="#e6edf3" Padding="10"/>
                        <WrapPanel Grid.Row="2" Margin="0,14,0,14" VerticalAlignment="Center">
                            <TextBlock Text="mode:" VerticalAlignment="Center" FontSize="11" Foreground="#8b949e" Margin="0,0,8,0"/>
                            <ListBox Name="EncoderModeList" SelectionChanged="OnEncoderModeChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="12,4"/>
                                        <Setter Property="Margin" Value="0,0,6,4"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#30363d"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#8b949e"/>
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="#21262d"/>
                                        <Setter Property="Foreground" Value="#7c6bff"/>
                                        <Setter Property="BorderBrush" Value="#7c6bff"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBoxItem Content="url encode" Tag="enc" IsSelected="True"/>
                                <ListBoxItem Content="url decode" Tag="dec"/>
                                <ListBoxItem Content="double encode" Tag="dbl"/>
                                <ListBoxItem Content="full url encode" Tag="full"/>
                                <ListBoxItem Content="base64 encode" Tag="b64enc"/>
                                <ListBoxItem Content="base64 decode" Tag="b64dec"/>
                                <ListBoxItem Content="caesar cipher" Tag="caesar"/>
                            </ListBox>
                        </WrapPanel>
                        <StackPanel Grid.Row="3" Name="CaesarConfigRow" Orientation="Horizontal" IsVisible="False" Margin="0,0,0,14" Spacing="10">
                            <TextBlock Text="shift:" VerticalAlignment="Center" FontSize="11" Foreground="#8b949e"/>
                            <NumericUpDown Name="CaesarShiftVal" Value="13" Minimum="1" Maximum="25" Width="120" ValueChanged="OnCaesarParamChanged"/>
                            <RadioButton Name="CaesarEncRadio" Content="encrypt" IsChecked="True" Checked="OnCaesarParamChanged"/>
                            <RadioButton Name="CaesarDecRadio" Content="decrypt" Checked="OnCaesarParamChanged"/>
                        </StackPanel>
                        <Border Grid.Row="4" Margin="0,10,0,0">
                            <Grid RowDefinitions="Auto, *">
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="OUTPUT" FontSize="10" FontWeight="Bold" Foreground="#6e7681" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="copy" Click="OnCopyEncoderOutput" Background="#3d3680" BorderBrush="#7c6bff" Foreground="#e6edf3" FontSize="11" Padding="12,3"/>
                                </Grid>
                                <TextBox Grid.Row="1" Name="EncoderOutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="#161b22" BorderBrush="#30363d" Foreground="#3fb950" Padding="10"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- IP LOOKUP PANEL -->
                    <Grid Name="ViewIpPanel" IsVisible="False" RowDefinitions="Auto, *">
                        <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="24,16">
                            <Grid RowDefinitions="Auto, Auto">
                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="IP Geolocation" Foreground="#7c6bff" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Resolve IP addresses to geographic and network data." Foreground="#6e7681" FontSize="12"/>
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                                    <TextBox Grid.Column="0" Name="IpAddressInput" KeyDown="OnGlobalKeyDown" Watermark="Enter IP or hostname (e.g. 8.8.8.8)..." Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3" Padding="10,8" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Content="Lookup" Click="OnIpLookupClick" Background="#3d3680" BorderBrush="#7c6bff" Foreground="#e6edf3" Padding="20,8"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" 
                                    VerticalScrollBarVisibility="Auto" 
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch">
                            <StackPanel Spacing="14" Margin="24,16">
                                <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="LOCATION DATA" FontSize="10" FontWeight="Bold" Foreground="#6e7681" LetterSpacing="1" Margin="0,0,0,10"/>
                                        <TextBox Name="IpLocationOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                Background="Transparent" BorderThickness="0" Foreground="#e6edf3"
                                                FontFamily="Consolas, monospace" FontSize="13"
                                                Text="Enter an IP address above and click Lookup."/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="WHOIS / NETWORK REGISTRATION" FontSize="10" FontWeight="Bold" Foreground="#6e7681" LetterSpacing="1" Margin="0,0,0,10"/>
                                        <TextBox Name="IpWhoisOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                Background="Transparent" BorderThickness="0" Foreground="#e6edf3"
                                                FontFamily="Consolas, monospace" FontSize="12"
                                                MinHeight="200"
                                                Text="Technical registration data will appear here."/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="MAP &amp; EXTERNAL TOOLS" FontSize="10" FontWeight="Bold" Foreground="#6e7681" LetterSpacing="1" Margin="0,0,0,10"/>
                                        <WrapPanel Name="IpMapLinksPanel" Orientation="Horizontal"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- OSINT PANEL -->
                    <Grid Name="ViewOsintPanel" IsVisible="False" Margin="24,20" RowDefinitions="Auto, Auto, *">
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="OSINT Command Center" Foreground="#7c6bff" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Direct-launch recon blueprints" Foreground="#6e7681" FontSize="12"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#161b22" Padding="14" Margin="0,0,0,16">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <ComboBox Grid.Column="0" Name="OsintTypeSelector" SelectedIndex="0" Width="160" Margin="0,0,12,0">
                                    <ComboBoxItem Content="Username" Tag="username"/>
                                    <ComboBoxItem Content="Email" Tag="email"/>
                                    <ComboBoxItem Content="Domain" Tag="domain"/>
                                    <ComboBoxItem Content="Full Name" Tag="person"/>
                                    <ComboBoxItem Content="Phone Number" Tag="phone"/>
                                    <ComboBoxItem Content="Devices / IOT" Tag="devices"/>
                                    <ComboBoxItem Content="Documents" Tag="documents"/>
                                </ComboBox>
                                <TextBox Grid.Column="1" Name="OsintTargetInput" KeyDown="OnGlobalKeyDown" Watermark="Enter structural target data..." Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3" Padding="10,8"/>
                                <Button Grid.Column="2" Content="Prepare Recon" Click="OnExecuteOsintHub" Background="#3d3680" BorderBrush="#7c6bff" Foreground="#e6edf3" Margin="12,0,0,0" Padding="16,8"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2">
                            <ItemsControl Name="OsintResultsContainer">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#e6edf3" FontSize="13"/>
                                                    <TextBlock Text="{Binding TargetUrl}" Foreground="#6e7681" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Launch Target ↗" Click="OnLaunchOsintLink" Tag="{Binding TargetUrl}" Background="Transparent" BorderBrush="#30363d" Foreground="#7c6bff" VerticalAlignment="Center" Padding="12,6"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- REVERSE SHELLS PANEL -->
                    <Grid Name="ViewRShellsPanel" IsVisible="False" Margin="24,20" RowDefinitions="Auto, Auto, *">
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Reverse Shell Generator" Foreground="#7c6bff" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Dynamic generation matrix. Edit LHOST/LPORT to update all shells." Foreground="#6e7681" FontSize="12"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#161b22" Padding="14" Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="LHOST (Attacker IP)" FontSize="11" Foreground="#8b949e" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Name="ShellLhostInput" Text="10.10.10.10" TextChanged="OnShellParamsChanged" Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3" FontFamily="Consolas, monospace"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="LPORT (Attacker Port)" FontSize="11" Foreground="#8b949e" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Name="ShellLportInput" Text="4444" TextChanged="OnShellParamsChanged" Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3" FontFamily="Consolas, monospace"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" ColumnDefinitions="160, *">
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,16,0">
                                <Button Content="All Shells" Click="OnShellFilterClick" Tag="all" Width="144"/>
                                <Button Content="Linux / Bash" Click="OnShellFilterClick" Tag="linux" Width="144"/>
                                <Button Content="Windows / PS" Click="OnShellFilterClick" Tag="windows" Width="144"/>
                                <Button Content="Scripting" Click="OnShellFilterClick" Tag="script" Width="144"/>
                                <TextBox Name="ShellSearchBox" Watermark="search shells..." TextChanged="OnShellSearchChanged"
                                         Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3"
                                         FontSize="11" Padding="8,6" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ScrollViewer Grid.Column="1">
                                <ItemsControl Name="ShellsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                                <Grid RowDefinitions="Auto, Auto, Auto">
                                                    <!-- Header row -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,8">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" Foreground="#7c6bff" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="#21262d" CornerRadius="4" Padding="4,2" Margin="8,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" Foreground="#8b949e" FontSize="10" FontFamily="Consolas, monospace"/>
                                                        </Border>
                                                        <Button Grid.Column="2" Content="copy" Click="OnCopyShellCommand" Tag="{Binding RawCommand}" Background="Transparent" BorderBrush="#30363d" Foreground="#3fb950" Padding="10,4" FontSize="11"/>
                                                    </Grid>
                                                    <!-- Tab row -->
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6" Spacing="2">
                                                        <Button Content="Raw" Tag="raw" Click="OnShellTabClick" Background="#0d1117" BorderBrush="#30363d" Foreground="#7c6bff" FontSize="11" Padding="10,4"/>
                                                        <Button Content="Base64" Tag="b64" Click="OnShellTabClick" Background="Transparent" BorderBrush="#30363d" Foreground="#8b949e" FontSize="11" Padding="10,4"/>
                                                        <Button Content="URL Encoded" Tag="url" Click="OnShellTabClick" Background="Transparent" BorderBrush="#30363d" Foreground="#8b949e" FontSize="11" Padding="10,4"/>
                                                    </StackPanel>
                                                    <!-- Command display -->
                                                    <TextBox Grid.Row="2" Text="{Binding DisplayCommand}" IsReadOnly="True" TextWrapping="Wrap"
                                                             Background="#0d1117" BorderBrush="#30363d" Foreground="#e6edf3"
                                                             Padding="8" FontSize="12" FontFamily="Consolas, monospace"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- WEBSHELLS PANEL -->
                    <Grid Name="ViewWebShellsPanel" IsVisible="False" Margin="24,20" RowDefinitions="Auto, Auto, *">
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Web Shells" Foreground="#7c6bff" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Pre-built web shells for common server-side languages." Foreground="#6e7681" FontSize="12"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#161b22" Padding="14" Margin="0,0,0,16">
                            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *">
                                <TextBlock Grid.Column="0" Text="LHOST:" VerticalAlignment="Center" FontSize="11" Foreground="#8b949e" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Name="WebShellLhostInput" Watermark="10.10.10.10" Width="160"
                                        TextChanged="OnWebShellParamsChanged"
                                        Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3" Padding="8,6" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="2" Text="LPORT:" VerticalAlignment="Center" FontSize="11" Foreground="#8b949e" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="3" Name="WebShellLportInput" Watermark="4444" Width="100"
                                        TextChanged="OnWebShellParamsChanged"
                                        Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3" Padding="8,6" Margin="0,0,16,0"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" ColumnDefinitions="160, *">
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,16,0">
                                <Button Content="All" Click="OnWebShellFilterClick" Tag="all" Width="144"/>
                                <Button Content="PHP" Click="OnWebShellFilterClick" Tag="php" Width="144"/>
                                <Button Content="ASPX" Click="OnWebShellFilterClick" Tag="aspx" Width="144"/>
                                <Button Content="JSP" Click="OnWebShellFilterClick" Tag="jsp" Width="144"/>
                                <TextBox Name="WebShellSearchBox" Watermark="search web shells..." TextChanged="OnWebShellSearchChanged"
                                        Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3"
                                        FontSize="11" Padding="8,6" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ScrollViewer Grid.Column="1">
                                <ItemsControl Name="WebShellsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                                <Grid RowDefinitions="Auto, Auto, Auto">
                                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,8">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" Foreground="#7c6bff" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="#21262d" CornerRadius="4" Padding="4,2" Margin="8,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" Foreground="#8b949e" FontSize="10" FontFamily="Consolas, monospace"/>
                                                        </Border>
                                                        <Button Grid.Column="2" Content="copy" Click="OnCopyWebShellCommand" Tag="{Binding RawCommand}" Background="Transparent" BorderBrush="#30363d" Foreground="#3fb950" Padding="10,4" FontSize="11"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="#6e7681" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                    <TextBox Grid.Row="2" Text="{Binding RawCommand}" IsReadOnly="True" TextWrapping="Wrap"
                                                            Background="#0d1117" BorderBrush="#30363d" Foreground="#e6edf3"
                                                            Padding="8" FontSize="12" FontFamily="Consolas, monospace"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- EXPLOIT PANEL -->
                    <Grid Name="ViewExploitPanel" IsVisible="False" Margin="24,20" RowDefinitions="Auto, Auto, *">
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Exploit Database Router" Foreground="#7c6bff" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Cross-reference vulnerabilities across public exploit repositories." Foreground="#6e7681" FontSize="12"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#161b22" Padding="14" Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" Name="ExploitQueryInput"
                                         KeyDown="OnGlobalKeyDown"
                                         Watermark="CVE-2023-38606, eternalblue, wordpress 6.0..."
                                         Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3"
                                         Padding="10,8" Margin="0,0,12,0"/>
                                <Button Grid.Column="1" Content="Query Repositories" Click="OnRunExploitSearch"
                                        Background="#3d3680" BorderBrush="#7c6bff" Foreground="#e6edf3" Padding="16,8"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2">
                            <ItemsControl Name="ExploitResultsContainer">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                            <Grid RowDefinitions="Auto, Auto, Auto">
                                                <TextBlock Grid.Row="0" Text="{Binding Name}" Foreground="#7c6bff" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="#8b949e" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                                <Button Grid.Row="2" Content="Execute Search ↗" Click="OnLaunchExploitLink" Tag="{Binding TargetUrl}"
                                                        Background="#3d3680" BorderBrush="#7c6bff" Foreground="#e6edf3"
                                                        HorizontalAlignment="Left" Padding="14,7"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- OBFUSCATE PANEL -->
                    <Grid Name="ViewObfuscatePanel" IsVisible="False" Margin="24,20" RowDefinitions="Auto, Auto, Auto, Auto, Auto, *">
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Code Obfuscator" Foreground="#7c6bff" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Obfuscate commands and scripts to evade pattern-based detection." Foreground="#6e7681" FontSize="12"/>
                        </StackPanel>

                        <!-- Language + Technique selectors -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,14" VerticalAlignment="Center">
                            <TextBlock Text="language:" VerticalAlignment="Center" FontSize="11" Foreground="#8b949e" Margin="0,0,8,4"/>
                            <ComboBox Name="ObfLangSelector" SelectedIndex="0" Width="160" SelectionChanged="OnObfLangChanged" Margin="0,0,16,4">
                                <ComboBoxItem Content="Bash / Shell" Tag="bash"/>
                                <ComboBoxItem Content="PowerShell" Tag="powershell"/>
                                <ComboBoxItem Content="Windows CMD" Tag="cmd"/>
                                <ComboBoxItem Content="Python" Tag="python"/>
                                <ComboBoxItem Content="PHP" Tag="php"/>
                                <ComboBoxItem Content="JavaScript" Tag="javascript"/>
                                <ComboBoxItem Content="Perl" Tag="perl"/>
                                <ComboBoxItem Content="Ruby" Tag="ruby"/>
                            </ComboBox>
                            <TextBlock Text="technique:" VerticalAlignment="Center" FontSize="11" Foreground="#8b949e" Margin="0,0,8,4"/>
                            <ListBox Name="ObfModeList" SelectionChanged="OnObfModeChanged" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="12,4"/>
                                        <Setter Property="Margin" Value="0,0,6,4"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#30363d"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#8b949e"/>
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="#21262d"/>
                                        <Setter Property="Foreground" Value="#7c6bff"/>
                                        <Setter Property="BorderBrush" Value="#7c6bff"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBoxItem Content="base64 wrap" Tag="b64" IsSelected="True"/>
                                <ListBoxItem Content="hex encode" Tag="hex"/>
                                <ListBoxItem Content="char concat" Tag="char"/>
                                <ListBoxItem Content="reverse" Tag="rev"/>
                                <ListBoxItem Content="var split" Tag="var"/>
                                <ListBoxItem Content="tick insert" Tag="tick"/>
                            </ListBox>
                        </WrapPanel>

                        <!-- Input -->
                        <TextBlock Grid.Row="2" Text="INPUT — paste your code or command" FontSize="10" FontWeight="Bold" Foreground="#6e7681" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="3" Name="ObfInputBox" Watermark="Paste the command or script to obfuscate..."
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="130"
                                 Background="#161b22" BorderBrush="#30363d" Foreground="#e6edf3"
                                 Padding="10" TextChanged="OnObfInputChanged" Margin="0,0,0,14"/>

                        <!-- Output header -->
                        <Grid Grid.Row="4" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="OBFUSCATED OUTPUT" FontSize="10" FontWeight="Bold" Foreground="#6e7681" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="copy" Click="OnCopyObfOutput" Background="#3d3680" BorderBrush="#7c6bff" Foreground="#e6edf3" FontSize="11" Padding="12,3"/>
                        </Grid>

                        <!-- Output -->
                        <Border Grid.Row="5" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="4">
                            <Grid RowDefinitions="*, Auto">
                                <TextBox Grid.Row="0" Name="ObfOutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         Background="Transparent" BorderThickness="0" Foreground="#3fb950"
                                         FontFamily="Consolas, monospace" FontSize="12" Padding="10"
                                         Text="result appears here"/>
                                <Border Grid.Row="1" Background="#0d1117" BorderBrush="#30363d" BorderThickness="0,1,0,0" Padding="10,8">
                                    <TextBlock Name="ObfTipText" Foreground="#6e7681" FontSize="11" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- SQLI PAYLOAD LAB -->
                    <Grid Name="ViewSqliPanel" IsVisible="False" RowDefinitions="Auto, Auto, *">

                        <!-- Header + target config -->
                        <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="24,14">
                            <StackPanel Spacing="10">
                                <StackPanel>
                                    <TextBlock Text="SQLi Payload Lab" Foreground="#7c6bff" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Set your target and select a payload to generate the final injection string." Foreground="#6e7681" FontSize="12"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*, Auto, Auto">
                                    <TextBox Grid.Column="0" Name="SqliTargetUrl" Watermark="https://target.example.com/page"
                                            Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3" Padding="10,8" Margin="0,0,8,0"
                                            TextChanged="OnSqliUrlOrPayloadChanged"/>
                                    <Button Grid.Column="1" Content="[+] Inject" Click="OnInjectMarker" 
                                            Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3" Margin="0,0,8,0" Padding="10,8"/>
                                    <Button Grid.Column="2" Content="Copy" Click="OnCopySqliPayload" 
                                            Background="#3d3680" BorderBrush="#7c6bff" Foreground="#e6edf3" Padding="14,8"/>
                                </Grid>

                                <DockPanel Margin="0,5,0,0" LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Copy All Exploits" Click="OnCopyAllPayloads"
                                            Background="#3d3680" BorderBrush="#7c6bff" Foreground="#e6edf3" 
                                            Padding="14,8" Margin="10,0,0,0"/>
                                    <CheckBox Name="EnableUrlEncoding" Content="Enable URL Encoding" IsChecked="True" 
                                            Foreground="#e6edf3" VerticalAlignment="Center"
                                            Checked="OnConfigChanged" Unchecked="OnConfigChanged"/>
                                </DockPanel>

                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Copy" Click="OnCopySqliPayload" 
                                            Background="#3d3680" BorderBrush="#7c6bff" Foreground="#e6edf3" Margin="8,0,0,0" Padding="14,8"/>
                                    <TextBox Name="SqliFinalPayload" 
                                            IsReadOnly="True" 
                                            Background="#0d1117" BorderBrush="#30363d" Foreground="#3fb950" 
                                            Padding="10,8" Watermark="Select a payload to see the result..."/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Category filters -->
                        <Border Grid.Row="1" Background="#0d1117" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="24,8">
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Name="SqliSearchBox"
                                            Watermark="filter..." Width="130"
                                            Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3"
                                            Padding="10,8" Margin="8,0,0,0" TextChanged="OnSqliFilterChanged"/>

                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="category:" VerticalAlignment="Center" FontSize="11" Foreground="#8b949e" Margin="0,0,10,0"/>
                                        <Button Content="All"           Tag="all"     Name="SqliBtnAll"     Click="OnSqliCatFilter" Background="#21262d" BorderBrush="#7c6bff" Foreground="#7c6bff" FontSize="11" Padding="10,4" Margin="0,0,5,0"/>
                                        <Button Content="Classic"       Tag="classic" Name="SqliBtnClassic" Click="OnSqliCatFilter" Background="Transparent" BorderBrush="#30363d" Foreground="#8b949e" FontSize="11" Padding="10,4" Margin="0,0,5,0"/>
                                        <Button Content="UNION"         Tag="union"   Name="SqliBtnUnion"   Click="OnSqliCatFilter" Background="Transparent" BorderBrush="#30363d" Foreground="#8b949e" FontSize="11" Padding="10,4" Margin="0,0,5,0"/>
                                        <Button Content="Time-Based"    Tag="time"    Name="SqliBtnTime"    Click="OnSqliCatFilter" Background="Transparent" BorderBrush="#30363d" Foreground="#8b949e" FontSize="11" Padding="10,4" Margin="0,0,5,0"/>
                                        <Button Content="Boolean Blind" Tag="bool"    Name="SqliBtnBool"    Click="OnSqliCatFilter" Background="Transparent" BorderBrush="#30363d" Foreground="#8b949e" FontSize="11" Padding="10,4" Margin="0,0,5,0"/>
                                        <Button Content="Error-Based"   Tag="error"   Name="SqliBtnError"   Click="OnSqliCatFilter" Background="Transparent" BorderBrush="#30363d" Foreground="#8b949e" FontSize="11" Padding="10,4" Margin="0,0,5,0"/>
                                        <Button Content="Stacked"       Tag="stacked" Name="SqliBtnStacked" Click="OnSqliCatFilter" Background="Transparent" BorderBrush="#30363d" Foreground="#8b949e" FontSize="11" Padding="10,4" Margin="0,0,5,0"/>
                                        <Button Content="Auth Bypass"   Tag="auth"    Name="SqliBtnAuth"    Click="OnSqliCatFilter" Background="Transparent" BorderBrush="#30363d" Foreground="#8b949e" FontSize="11" Padding="10,4" Margin="0,0,5,0"/>
                                        <Button Content="WAF Bypass"    Tag="waf"     Name="SqliBtnWaf"     Click="OnSqliCatFilter" Background="Transparent" BorderBrush="#30363d" Foreground="#8b949e" FontSize="11" Padding="10,4"/>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>

                        <!-- Payload list -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ListBox Name="SqliPayloadList" 
                                    SelectionChanged="OnSqliPayloadSelected" 
                                    Background="Transparent" 
                                    Margin="24,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1"
                                                CornerRadius="5" Padding="12,8" Margin="0,0,0,7">
                                            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                                <Border Grid.Column="0" Background="#21262d" CornerRadius="3"
                                                        Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" Foreground="#7c6bff"
                                                            FontSize="10" FontFamily="Consolas, monospace" FontWeight="Bold"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" Foreground="#e6edf3" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Payload}" Foreground="#3fb950" FontSize="11"
                                                            FontFamily="Consolas, monospace" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Copy URL" Click="OnSqliCopyUrl"
                                                        Tag="{Binding}" Background="Transparent" BorderBrush="#30363d"
                                                        Foreground="#6e7681" FontSize="11" Padding="10,4" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Content="Copy Payload" Click="OnSqliCopyPayload"
                                                        Tag="{Binding Payload}" Background="Transparent" BorderBrush="#30363d"
                                                        Foreground="#3fb950" FontSize="11" Padding="10,4" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>

                    <!-- HTTP REPEATER -->
                    <Grid Name="ViewRepeaterPanel" IsVisible="False" RowDefinitions="Auto, *">

                        <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="24,14">
                            <StackPanel>
                                <TextBlock Text="HTTP Repeater" Foreground="#7c6bff" FontSize="18" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBlock Text="Craft and replay HTTP requests manually. Ctrl+Enter to send." Foreground="#6e7681" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="*, 4, *">
                        
                            <Grid Grid.Column="0" RowDefinitions="Auto, Auto, *, Auto">
                            
                                <Border Grid.Row="0" Background="#0d1117" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                        <ComboBox Grid.Column="0" Name="RepeaterMethod" SelectedIndex="0" Width="96" Background="#21262d" BorderBrush="#30363d" Margin="0,0,8,0">
                                            <ComboBoxItem Content="GET"/>
                                            <ComboBoxItem Content="POST"/>
                                            <ComboBoxItem Content="PUT"/>
                                            <ComboBoxItem Content="PATCH"/>
                                            <ComboBoxItem Content="DELETE"/>
                                        </ComboBox>
                                        <TextBox Grid.Column="1" Name="RepeaterUrl" Watermark="https://target.example.com/endpoint" Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3" Padding="10,8" Margin="0,0,8,0" KeyDown="OnRepeaterKeyDown"/>
                                        <Button Grid.Column="2" Content="Send" Click="OnRepeaterSend" Background="#3d3680" BorderBrush="#7c6bff" Foreground="#e6edf3" Padding="18,8" Margin="0,0,6,0" FontWeight="Bold"/>
                                        <Button Grid.Column="3" Content="Clear" Click="OnRepeaterClear" Background="Transparent" BorderBrush="#30363d" Foreground="#8b949e" Padding="10,8"/>
                                    </Grid>
                                </Border>

                                <Button Grid.Row="1" 
                                        Content="Send with Headers" 
                                        Click="OnRepeaterSendWithHeaders"
                                        Background="#3d3680" 
                                        BorderBrush="#7c6bff" 
                                        Foreground="#e6edf3"
                                        HorizontalAlignment="Stretch" 
                                        Padding="10,8" 
                                        Margin="12,8"/>

                                <TextBox Grid.Row="2" 
                                        Name="RepeaterRawRequest" 
                                        AcceptsReturn="True" 
                                        TextWrapping="NoWrap" 
                                        Watermark="GET / HTTP/1.1&#10;Host: example.com&#10;&#10;[Body goes here]" 
                                        Background="#0d1117" 
                                        BorderThickness="0" 
                                        Foreground="#e6edf3" 
                                        FontFamily="Consolas, monospace" 
                                        FontSize="12" 
                                        Padding="16,12" 
                                        ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                    
                                <Border Grid.Row="3" Background="#0d1117" BorderBrush="#30363d" BorderThickness="0,1,0,0" Padding="12,7">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <CheckBox Name="RepeaterFollowRedirects" Content="Follow redirects" 
                                                IsChecked="True" Foreground="#8b949e" FontSize="11"/>
                                        <CheckBox Name="RepeaterSkipSslVerify" Content="Skip SSL verify" 
                                                IsChecked="True" Foreground="#8b949e" FontSize="11"/>
                                        <TextBlock Name="RepeaterSendingHint" Text="" Foreground="#7c6bff" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            
                            <GridSplitter Grid.Column="1" Background="#30363d" ResizeDirection="Columns" Width="4" HorizontalAlignment="Stretch"/>
                            
                            <Grid Grid.Column="2" RowDefinitions="Auto, Auto, *">
                                <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                                            <TextBlock Text="RESPONSE" FontSize="10" FontWeight="Bold" Foreground="#6e7681" VerticalAlignment="Center"/>
                                            <Border Name="RepeaterStatusBadge" Background="#21262d" CornerRadius="3" Padding="8,3">
                                                <TextBlock Name="RepeaterStatusTxt" Text="—" Foreground="#6e7681" FontSize="12" FontFamily="Consolas, monospace" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Name="RepeaterTimingTxt" Text="" Foreground="#6e7681" 
                                                    FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Name="RepeaterSizeTxt"
                                                    Text="" Foreground="#6e7681" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Content="Open in Browser" Click="OnRepeaterOpenBrowser"
                                                     Background="Transparent" BorderBrush="#30363d" 
                                                     Foreground="#7c6bff" FontSize="11" Padding="10,4"/>
                                            <Button Content="Load Headers" Click="OnLoadResponseHeadersToRequest" 
                                                    Background="Transparent" BorderBrush="#30363d" Foreground="#3fb950" 
                                                    FontSize="11" Padding="10,4"/>
                                            <Button Content="Copy" Click="OnRepeaterCopyResp" Background="Transparent" 
                                                    BorderBrush="#30363d" Foreground="#8b949e" FontSize="11" Padding="10,4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                
                                <Border Grid.Row="1" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Name="RespTabHeaders" Content="Headers" Tag="headers" Click="OnRespTabClick" 
                                                Background="#21262d" BorderBrush="#7c6bff" Foreground="#7c6bff" 
                                                FontSize="11" Padding="10,4"/>
                                        <Button Name="RespTabBody" Content="Body" 
                                                Tag="body" Click="OnRespTabClick" Background="Transparent" 
                                              BorderBrush="#30363d" Foreground="#8b949e" FontSize="11" Padding="10,4"/>
                                        <Button Name="RespTabFull" Content="Full" Tag="full" 
                                              Click="OnRespTabClick" Background="Transparent" BorderBrush="#30363d" 
                                              Foreground="#8b949e" FontSize="11" Padding="10,4"/>
                                    </StackPanel>
                                </Border>
                                
                                <TextBox Grid.Row="2" Name="RepeaterRespBox" 
                                IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" 
                                Background="#0d1117" BorderThickness="0" Foreground="#e6edf3"
                                FontFamily="Consolas, monospace" FontSize="12" Padding="16,12" 
                                Text="Send a request to see the response here." 
                                ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>

            <!-- STATUS BAR -->
            <Border Grid.Row="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,1,0,0" Height="26" Padding="16,0">
                <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                    <TextBlock Grid.Column="0" Name="StatusCategoryTxt" Text="—" VerticalAlignment="Center" FontSize="11" Foreground="#6e7681" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="1" Name="StatusNoteTxt" Text="no note selected" VerticalAlignment="Center" FontSize="11" Foreground="#6e7681"/>
                    <TextBlock Grid.Column="3" Name="StatusCharCountTxt" Text="" VerticalAlignment="Center" FontSize="11" Foreground="#6e7681"/>
                </Grid>
            </Border>
        </Grid>

        <!-- CATEGORY DIALOG OVERLAY -->
        <Grid Name="CategoryDialogOverlay" Background="#b0000000" IsVisible="False">
            <Border Background="#161b22" BorderBrush="#7c6bff" BorderThickness="1" CornerRadius="8" Width="400" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid RowDefinitions="Auto, *, Auto">
                    <TextBlock Grid.Row="0" Name="CategoryDialogTitle" Text="Create Category" FontSize="14" FontWeight="Bold" Foreground="#7c6bff"/>
                    <TextBox Grid.Row="1" Name="CategoryDialogInput" Watermark="Category name..." KeyDown="OnCategoryDialogKeyDown" VerticalAlignment="Center" Background="#21262d" BorderBrush="#30363d" Foreground="#e6edf3"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Cancel" Click="OnCancelCategoryDialog" Background="Transparent" BorderBrush="#30363d" Foreground="#8b949e"/>
                        <Button Content="Save" Click="OnSaveCategoryDialog" Background="#3d3680" BorderBrush="#7c6bff" Foreground="#e6edf3" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
